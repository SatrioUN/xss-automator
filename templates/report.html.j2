<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>XSS Automator Report - {{ report.generated_at }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    .finding { border: 1px solid #ddd; padding: 12px; margin-bottom: 12px; border-radius: 6px; }
    .snippet { background:#f5f5f5; padding:8px; font-family:monospace; white-space:pre-wrap; }
  </style>
</head>
<body>
  <h1>XSS Automator Report</h1>
  <p>Generated at: {{ report.generated_at }}</p>
  <h2>Findings ({{ report.findings|length }})</h2>
  {% for f in report.findings %}
  <div class="finding">
    <strong>URL:</strong> {{ f.url }}<br>
    <strong>Param:</strong> {{ f.meta.param or f.param or "N/A" }}<br>
    <strong>Evidence:</strong> {{ f.evidence.type }}<br>
    {% if f.evidence.snippet %}
    <div class="snippet">{{ f.evidence.snippet }}</div>
    {% elif f.evidence.note %}
    <div class="snippet">{{ f.evidence.note }}</div>
    {% endif %}
  </div>
  {% endfor %}
</body>
</html>
